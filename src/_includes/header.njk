{#- One nav for the whole site. The Shop mega-panel is generated from
    _data/departments.json; aria-current is computed by comparing page.url,
    never hand-set.

    No-JS: layout.njk carries a <noscript> block that hides the hamburger and
    renders the nav as a plain stacked list, so every link stays reachable
    with scripting disabled. -#}
{%- from "icons.njk" import caret, menu, icon -%}

{%- set navItems = [
  { url: "/index.html",       label: "Home" },
  { url: "/departments.html", label: "Shop", dropdown: true },
  { url: "/services.html",    label: "Services" },
  { url: "/guides/",          label: "Guides" },
  { url: "/reviews.html",     label: "Reviews" },
  { url: "/faq.html",         label: "FAQ" },
  { url: "/about.html",       label: "About" },
  { url: "/contact.html",     label: "Contact" }
] -%}

{%- set deptUrls = [] -%}
{%- for d in departments %}{%- set _ = deptUrls.push(d.url) -%}{%- endfor -%}

<header class="site-header" id="header">

  {#- Utility strip: the three things a local visitor most often wants.
      Hours are static text from site.json. There is deliberately no live
      "open now" badge — holiday hours are still an open question, so a
      status indicator would confidently state something unverifiable. -#}
  <div class="utility-strip">
    <div class="utility-inner">
      <a class="utility-item utility-phone" href="tel:{{ site.phone.tel }}">
        {{ icon("phone", 16) }}<span>{{ site.phone.display }}</span>
      </a>
      <p class="utility-item utility-hours">
        {{ icon("clock", 16) }}
        <span>
          {%- for h in site.hours %}{{ h.label }} {{ h.display }}{% if not loop.last %} &middot; {% endif %}{% endfor -%}
        </span>
      </p>
      <a class="utility-item utility-directions" href="{{ site.map.link }}"
         target="_blank" rel="noopener">
        {{ icon("pin", 16) }}<span>Directions</span>
      </a>
    </div>
  </div>

  <div class="header-main">
    <div class="logo-wrap">
      <a href="/index.html"><img src="/images/yonkerslogo.png" alt="{{ site.name }} home" width="500" height="500"></a>
    </div>

    <button class="nav-toggle" id="navToggle" type="button"
            aria-controls="navMenu" aria-expanded="false" aria-label="Open menu">{{ menu() }}</button>

    <nav class="top-nav" id="mainNav" aria-label="Primary">
      <div class="drawer-head">
        <div>
          <span class="drawer-kicker">Yonkers Paint &amp; Hardware</span>
          <span class="drawer-title">Shop &amp; Explore</span>
        </div>
        <button class="drawer-close" id="navClose" type="button" aria-label="Close menu">&times;</button>
      </div>

      <ul id="navMenu">
        {%- for item in navItems %}
          {#- Eleventy serves index.njk at "/", so /index.html has to match it too. -#}
          {%- set isCurrent = (page.url == item.url)
                or (item.url == "/index.html" and page.url == "/")
                or (item.url == "/guides/" and "/guides/" in page.url) -%}
          {%- if item.dropdown %}
        {%- set inDepts = (page.url == item.url) or (page.url in deptUrls) -%}
        <li class="has-sub{% if inDepts %} is-current-section{% endif %}">
          <button class="sub-toggle" type="button" aria-expanded="false"
                  aria-controls="deptMenu"><span>{{ item.label }}</span>{{ caret() }}</button>

          <div class="mega" id="deptMenu">
            <div class="mega-inner">
              <div class="mega-head">
                <div class="mega-head-copy">
                  <span class="mega-kicker">Shop Departments</span>
                  <strong>Find what the job calls for.</strong>
                  <p>Paint, tools, plumbing, electrical, hardware and more — with help at the counter when you need it.</p>
                </div>
                <a class="mega-head-link" href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>All departments <span aria-hidden="true">&rarr;</span></a>
              </div>

              <ul class="mega-grid">
                {%- for d in departments %}
                <li>
                  <a href="{{ d.url }}"{% if page.url == d.url %} aria-current="page"{% endif %}>
                    <span class="mega-name-row">
                      <span class="mega-name">{{ d.name }}</span>
                      <span class="mega-arrow" aria-hidden="true">&rarr;</span>
                    </span>
                    <span class="mega-blurb">{{ d.seoDescription }}</span>
                  </a>
                </li>
                {%- endfor %}
              </ul>

              <div class="mega-foot">
                <p><strong>Not sure which department?</strong> Call the store or stop by 65 Main Street in Getty Square.</p>
                <div class="mega-foot-actions">
                  <a href="tel:{{ site.phone.tel }}">{{ icon("phone", 16) }}<span>Call {{ site.phone.display }}</span></a>
                  <a href="{{ site.map.link }}" target="_blank" rel="noopener">{{ icon("pin", 16) }}<span>Directions</span></a>
                </div>
              </div>
            </div>
          </div>
        </li>
          {%- else %}
        <li><a href="{{ item.url }}"{% if isCurrent %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
          {%- endif %}
        {%- endfor %}
      </ul>

      {#- Pinned in the mobile drawer; hidden on desktop. -#}
      <div class="drawer-cta">
        <a class="btn" href="tel:{{ site.phone.tel }}">{{ icon("phone", 18) }}<span>Call Store</span></a>
        <a class="drawer-directions" href="{{ site.map.link }}" target="_blank" rel="noopener">{{ icon("pin", 17) }}<span>Directions</span></a>
      </div>
    </nav>
  </div>

  <div class="nav-scrim" id="navScrim" hidden></div>
</header>
