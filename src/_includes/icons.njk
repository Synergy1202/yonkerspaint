{#- Inline SVG for the three UI glyphs that were previously font characters
    (U+2605/U+2606 stars, U+25BE caret, U+2630 hamburger). Those code points
    sit outside the latin subset the site self-hosts, so they were rendering
    in whatever system face the browser fell back to. As SVG they draw
    identically everywhere and inherit currentColor.
    Emoji are deliberately left as characters: system emoji fallback is
    expected behaviour. -#}

{%- macro stars(rating, outOf) -%}
{%- set total = outOf or 5 -%}
<span class="stars">
  <span class="stars-icons" aria-hidden="true">
    {%- for i in range(1, total + 1) %}
    <svg viewBox="0 0 24 24" width="18" height="18" focusable="false">
      {%- if i <= rating %}
      <path fill="currentColor" d="M12 2.6l2.83 5.73 6.32.92-4.57 4.46 1.08 6.3L12 17.03l-5.66 2.98 1.08-6.3-4.57-4.46 6.32-.92L12 2.6z"/>
      {%- else %}
      <path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" d="M12 3.6l2.55 5.16 5.7.83-4.13 4.02.98 5.68L12 16.61l-5.1 2.68.98-5.68-4.13-4.02 5.7-.83L12 3.6z"/>
      {%- endif %}
    </svg>
    {%- endfor %}
  </span>
  <span class="visually-hidden">Rated {{ rating }} out of {{ total }}</span>
</span>
{%- endmacro -%}

{%- macro caret() -%}
<svg class="icon-caret" viewBox="0 0 12 8" width="12" height="8" aria-hidden="true" focusable="false">
  <path fill="currentColor" d="M1.4.6 6 5.2 10.6.6 12 2 6 8 0 2z"/>
</svg>
{%- endmacro -%}

{%- macro menu() -%}
<svg class="icon-menu" viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" focusable="false">
  <path fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"
        d="M3 6h18M3 12h18M3 18h18"/>
</svg>
{%- endmacro -%}

{#- Named UI icons. All decorative: aria-hidden, with visible text doing the
    labelling work in every placement. 24x24 grid, currentColor. -#}
{%- macro icon(name, size) -%}
{%- set s = size or 24 -%}
<svg class="icon icon--{{ name }}" viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}"
     aria-hidden="true" focusable="false" fill="none" stroke="currentColor"
     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
  {%- if name == "phone" %}
  <path d="M6.5 3h3l1.5 4-2 1.5a12 12 0 0 0 6.5 6.5L17 13l4 1.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4 5.2 2 2 0 0 1 6 3Z"/>
  {%- elif name == "clock" %}
  <circle cx="12" cy="12" r="8.5"/><path d="M12 7v5.2l3.2 2"/>
  {%- elif name == "pin" %}
  <path d="M12 21s6.5-6 6.5-10.5a6.5 6.5 0 1 0-13 0C5.5 15 12 21 12 21Z"/><circle cx="12" cy="10.5" r="2.4"/>
  {%- elif name == "truck" %}
  <path d="M2 6.5h11v9H2zM13 9.5h4l4 3.5v2.5h-8z"/><circle cx="6" cy="18" r="1.8"/><circle cx="17.5" cy="18" r="1.8"/>
  {%- elif name == "key" %}
  <circle cx="7.5" cy="13" r="3.8"/><path d="M10.8 11.2 21 4.8m-3.2 2 1.9 2.3m-4.4-.2 1.9 2.3"/>
  {%- elif name == "drop" %}
  <path d="M12 3.2c3.2 3.7 5.4 6.4 5.4 8.9a5.4 5.4 0 0 1-10.8 0c0-2.5 2.2-5.2 5.4-8.9Z"/>
  {%- elif name == "chat" %}
  <path d="M20 14.5a2.5 2.5 0 0 1-2.5 2.5H8l-4 3.5V6.5A2.5 2.5 0 0 1 6.5 4h11A2.5 2.5 0 0 1 20 6.5Z"/>
  {%- elif name == "wrench" %}
  <path d="M15.2 6.2a4.2 4.2 0 0 0 5.3 5.4l-8.6 8.6a2.4 2.4 0 0 1-3.4-3.4Z"/><path d="M20.5 11.6 15.2 6.2l1.6-1.6a4.2 4.2 0 0 1 5.3 5.4Z"/>
  {%- elif name == "box" %}
  <path d="M3.5 7.6 12 3.5l8.5 4.1v8.8L12 20.5l-8.5-4.1Z"/><path d="M3.5 7.6 12 11.8l8.5-4.2M12 11.8v8.7"/>
  {%- elif name == "mail" %}
  <rect x="3" y="5.5" width="18" height="13" rx="2"/><path d="m3.8 6.8 8.2 6 8.2-6"/>
  {%- endif %}
</svg>
{%- endmacro -%}
