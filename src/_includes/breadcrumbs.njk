{#- Visible breadcrumb navigation.
    Department detail pages are paginated from `departments`, so use the live
    `dept` item directly here instead of the computed `crumbs` array. This
    prevents every generated department page from inheriting the first
    department label (Paint & Finishing). -#}
{%- if pageType == "department" and dept %}
<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    <li><a href="/index.html">Home</a></li>
    <li><a href="/departments.html">Departments</a></li>
    <li><span aria-current="page">{{ dept.name | safe }}</span></li>
  </ol>
</nav>
{%- elif crumbs and crumbs.length %}
<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    {%- for c in crumbs %}
    <li>
      {%- if loop.last %}
      <span aria-current="page">{{ c.label | safe }}</span>
      {%- else %}
      <a href="{{ c.url }}">{{ c.label | safe }}</a>
      {%- endif %}
    </li>
    {%- endfor %}
  </ol>
</nav>
{%- endif %}
