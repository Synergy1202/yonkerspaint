<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">

{%- set canonical = site.origin + page.url -%}
{%- set ogImage = site.origin + "/images/" + (ogImageFile or "og-default.jpg") -%}

<title>{{ title }}</title>
{%- if description %}
<meta name="description" content="{{ description }}">
{%- endif %}
{%- if noindex %}
<meta name="robots" content="noindex">
{%- else %}
<link rel="canonical" href="{{ canonical }}">
{%- endif %}

<link rel="icon" href="/favicon.ico" sizes="any">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">

<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:url" content="{{ canonical }}">
<meta property="og:title" content="{{ ogTitle or title }}">
{%- if description %}
<meta property="og:description" content="{{ ogDescription or description }}">
{%- endif %}
<meta property="og:image" content="{{ ogImage }}">
<meta name="twitter:card" content="summary_large_image">

<link rel="preload" href="/fonts/barlow-condensed-600-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/source-sans-3-400-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/css/site.css?v=20260908-redesign">

{#- No-JS fallback. The drawer needs script to open, so with JavaScript
    disabled we drop the drawer entirely and render the nav as a plain
    stacked list. Every link stays reachable; nothing is hidden. -#}
<noscript>
  <style>
    .nav-toggle,.drawer-head,.drawer-close,.nav-scrim,.drawer-cta{display:none !important}
    @media(max-width:820px){
      .header-main{flex-wrap:wrap}
      .top-nav{position:static;width:100%;transform:none;box-shadow:none;
               background:none;overflow:visible;max-height:none}
      .top-nav > ul{display:flex;flex-direction:column;padding:0 0 var(--space-3)}
      .mega{display:block;position:static;transform:none;width:auto;
            background:rgb(0 0 0 / .18);box-shadow:none;border-radius:0;color:var(--on-primary)}
      .mega-name{color:var(--on-primary)}
      .sub-toggle{display:none}
    }
  </style>
</noscript>

{% include "structured-data.njk" %}
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>

<a class="skip-link" href="#main">Skip to main content</a>

{% include "header.njk" %}

<main id="main">
{% include "breadcrumbs.njk" %}
{%- if pageType == "guide" %}
{%- if heroImage %}
{#- Guide heroes are short inner-page bands, so the 800px derivative is
    plenty and keeps each guide inside its payload budget. -#}
<section class="hero hero--photo hero--inner guide-showroom-hero" style="background-image:url('/images/wide/{{ heroImage }}')">
  <div class="guide-showroom-hero__panel">
    <p class="eyebrow">Project Guide &bull; Yonkers Paint &amp; Hardware</p>
    <h1>{{ h1 }}</h1>
  </div>
</section>
{%- else %}
<section class="hero hero--flat hero--inner guide-showroom-hero guide-showroom-hero--flat">
  <div class="guide-showroom-hero__panel">
    <p class="eyebrow">Project Guide &bull; Yonkers Paint &amp; Hardware</p>
    <h1>{{ h1 }}</h1>
  </div>
</section>
{%- endif %}
<div class="wrap guide-body">
<p class="guide-lede">{{ lede }}</p>
{%- endif %}
{{ content | safe }}
{%- if pageType == "guide" %}
</div>
{%- endif %}
{%- if not noCta %}
{% include "cta-band.njk" %}
{%- endif %}
</main>

{% include "footer.njk" %}

<script src="/js/site.js" defer></script>
</body>
</html>
